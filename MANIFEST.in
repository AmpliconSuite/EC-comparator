include README.md
include requirements.txt
include environment.yml

recursive-include eccomparator/utils *
recursive-include docs *
recursive-include examples/ecdna1/true.bed
recursive-include examples/ecdna1/reconstructed.bed
recursive-include examples/ecdna1/output/ *

prune dist
prune build
prune *.egg-info
global-exclude __pycache__
global-exclude *.py[co]